generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../local/dev.db"
}

model Item {
  id            Int      @id @default(autoincrement())
  type          String
  source        String
  sourceId      String   @map("source_id")
  title         String
  originalTitle String?  @map("original_title")
  year          Int?
  coverUrl      String?  @map("cover_url")
  description   String?
  extraJson     String?  @map("extra_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  entry         Entry?
  collections   CollectionItem[]

  @@unique([type, source, sourceId])
  @@map("items")
}

model Entry {
  id         Int      @id @default(autoincrement())
  itemId     Int      @unique @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status     String
  rating     Int?
  review     String?
  startedOn  String?  @map("started_on")
  finishedOn String?  @map("finished_on")
  tags       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("entries")
}

model Collection {
  id        Int              @id @default(autoincrement())
  type      String
  name      String
  createdAt DateTime         @default(now()) @map("created_at")
  items     CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  collectionId Int        @map("collection_id")
  itemId       Int        @map("item_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([collectionId, itemId])
  @@map("collection_items")
}

model SteamPaidPrice {
  appid     Int      @id
  paidFen   Int      @map("paid_fen")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("steam_paid_prices")
}
